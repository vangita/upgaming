GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Answers when GROQ_MODEL's daily limit is used up; leave empty for no fallback
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Files the API cannot replace or delete, besides the base dataset. The public demo protects the samples:
# ["inc-2041-postmortem.md","inc-2041-status-page.txt","inc-2041-support-summary.docx","reliability-report-q1-2026.pdf"]
PROTECTED_SOURCES=[]

LOG_LEVEL=INFO
